---
import Base from '../../layouts/Base.astro';
import Silhouette from '../../components/Silhouette.astro';
import SpeciesCard from '../../components/SpeciesCard.astro';
import NicheList from '../../components/NicheList.astro';
import { getEntry, render } from 'astro:content';
import { children, getSpecies, lineage, statusLabel, type Species } from '../../lib/data';
import { personLd } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getSpecies();
  return all.map((species) => ({ params: { slug: species.id }, props: { species } }));
}

interface Props { species: Species }
const { species } = Astro.props;
const d = species.data;
const { Content } = await render(species);
const all = await getSpecies();
const era = (await getEntry(d.era))!;
const chain = lineage(all, species);
const descendants = children(all, species.id);
const site = Astro.site!;
const jsonLd = [
  {
    '@type': 'Article',
    headline: `${d.name} (${d.binomial})`,
    description: d.summary,
    url: new URL(Astro.url.pathname, site).href,
    image: new URL(`/og/${species.id}.png`, site).href,
    author: d.credit ? { '@type': 'Person', name: d.credit.name, ...(d.credit.url && { url: d.credit.url }) } : personLd(site),
    about: d.status === 'real'
      ? { '@type': 'Taxon', name: d.binomial }
      : { '@type': 'Thing', name: d.name, description: 'A fictional species in a speculative evolution scenario.' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Cocaine hippos', item: new URL('/hippos/', site).href },
      { '@type': 'ListItem', position: 2, name: `${era.data.label}: ${era.data.title}`, item: new URL(`/hippos/${era.id}/`, site).href },
      { '@type': 'ListItem', position: 3, name: d.name },
    ],
  },
];
const confidenceText = {
  established: 'Established science: this species exists today.',
  plausible: 'Plausible: built on close real-world parallels.',
  speculative: 'Speculative: a bold but reasoned guess.',
};
---
<Base
  title={`${d.name} (${d.binomial})`}
  description={`${d.summary} ${era.data.label} in the speculative evolution of Colombia's hippos.`}
  ogImage={`/og/${species.id}.png`}
  jsonLd={jsonLd}
>
  <article class="wrap">
    <p class="eyebrow"><a href={`/hippos/${era.id}/`}>{era.data.label} · {era.data.title}</a></p>
    <div class="head">
      <div>
        <h1>{d.name}</h1>
        <p class="binomial"><em>{d.binomial}</em></p>
        <p class="badges">
          <span class:list={['badge', d.status]}>{statusLabel[d.status]}</span>
          <span class="badge conf" title={confidenceText[d.confidence]}>{d.confidence}</span>
        </p>
        <p class="lead">{d.summary}</p>
      </div>
      <figure class="art">
        <Silhouette shape={d.shape} label={`Silhouette of ${d.name}`} />
        {d.status !== 'real' && (
          <figcaption>Placeholder silhouette. <a href={`/contribute/?context=${encodeURIComponent('art:' + species.id)}`}>Draw this species →</a></figcaption>
        )}
      </figure>
    </div>

    <div class="layout">
      <div class="prose">
        <Content />
        {d.sources.length > 0 && (
          <>
            <h2>Sources</h2>
            <ul class="sources">{d.sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}</ul>
          </>
        )}
        <NicheList niches={d.niches} context={`species:${species.id}`} />
      </div>

      <aside class="card side">
        <dl class="facts">
          <dt>Niche</dt><dd>{d.niche}</dd>
          <dt>Diet</dt><dd>{d.diet}</dd>
          <dt>Size</dt><dd>{d.size}</dd>
          <dt>Habitat</dt><dd>{d.habitat}</dd>
          {d.credit && (<><dt>Created by</dt><dd>{d.credit.url ? <a href={d.credit.url}>{d.credit.name}</a> : d.credit.name}</dd></>)}
        </dl>
        <h3>Lineage</h3>
        <ol class="lineage">
          {chain.map((s) => (
            <li>{s.id === species.id ? <strong>{s.data.name}</strong> : <a href={`/species/${s.id}/`}>{s.data.name}</a>}</li>
          ))}
        </ol>
        <p class="small"><a href="/tree/">Whole tree →</a></p>
        <p class="small"><a href="/hippos/#faq">Facts about the real cocaine hippos →</a></p>
      </aside>
    </div>

    <h2>Descendants</h2>
    {descendants.length > 0 ? (
      <div class="grid">{descendants.map((s) => <SpeciesCard species={s} />)}</div>
    ) : (
      <p class="muted">No known descendants yet.</p>
    )}
    <p>
      <a class="btn secondary" href={`/contribute/?context=${encodeURIComponent('species:' + species.id)}&ancestor=${species.id}`}>
        Propose a descendant of the {d.name.toLowerCase()}
      </a>
    </p>
  </article>
</Base>

<style>
  .head { display: grid; grid-template-columns: 1fr minmax(12rem, 22rem); gap: 2rem; align-items: center; }
  .binomial { margin: 0; color: var(--muted); font-size: 1.15rem; }
  .badges { display: flex; gap: 0.5rem; margin: 0.75rem 0; }
  .art { margin: 0; background: var(--mud-soft); border-radius: var(--radius); padding: 1.5rem 2rem 1rem; }
  figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 0.75rem; text-align: center; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 2.5rem; align-items: start; margin-top: 1rem; }
  .side h3 { margin-top: 1.25rem; }
  .lineage { padding-left: 1.2rem; margin: 0; }
  .small { font-size: 0.9rem; margin-bottom: 0; }
  .sources { font-size: 0.92rem; padding-left: 1.2rem; }
  @media (max-width: 50rem) {
    .head, .layout { grid-template-columns: 1fr; }
    .side { order: -1; }
  }
</style>
